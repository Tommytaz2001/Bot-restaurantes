# OpenAI
OPENAI_API_KEY=sk-proj-...

# Firebase (solo necesitas PROJECT_ID, API_KEY y STORAGE_BUCKET)
FIREBASE_API_KEY=AIzaSy...
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app

# Servidor
PORT=3001
BACKEND_URL=https://tu-app.onrender.com   # URL pública del servidor (para logs)

# WhatsApp (Baileys)
WHATSAPP_ENABLED=true      # true en producción
RESTAURANTE_ID=urbano      # ID del restaurante en Firestore

# Docker
BOT_CONTAINER_NAME=bot-restaurantes   # nombre del contenedor del backend

# Elasticsearch + Kibana (opcional — para métricas)
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTIC_PASSWORD=cambia_esta_contrasena
ELASTIC_VERSION=8.13.4                # versión de ES/Kibana/Filebeat
ES_JAVA_OPTS=-Xms512m -Xmx512m       # memoria para Elasticsearch

# Kibana
KIBANA_PORT=5601
KIBANA_SERVER_NAME=kibana
KIBANA_PUBLIC_URL=http://localhost:5601
KIBANA_LOG_LEVEL=warn                 # error | warn | info | debug

# Kibana — configuración del data view
KIBANA_INDEX_PATTERN=bot-logs-*
KIBANA_DATA_VIEW_ID=bot-logs
KIBANA_DATA_VIEW_TITLE=Bot Logs
