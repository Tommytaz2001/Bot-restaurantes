# ══════════════════════════════════════════════════════════════════════════════
# Bot Restaurantes — Variables de Entorno (PostgreSQL + Gemini + WhatsApp)
# ══════════════════════════════════════════════════════════════════════════════
# Copia este archivo como .env y completa tus valores reales:
#   cp .env.example .env
#
# NUNCA subas .env al repositorio.
# ══════════════════════════════════════════════════════════════════════════════

# ── Inteligencia Artificial: Google Gemini (Recomendado) ──────────────────────
# Obtén tu clave en: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# (Opcional) OpenAI Fallback
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini

# ── Base de Datos Relacional: PostgreSQL ──────────────────────────────────────
# Si usas Docker Compose (valores por defecto ya incluidos):
DB_USER=botuser
DB_PASSWORD=botpassword
DB_NAME=botrestaurantes
DB_PORT=5432
DB_HOST=postgres

# O cadena de conexión completa (útil para Neon, Supabase o desarrollo local):
DATABASE_URL=postgresql://botuser:botpassword@localhost:5432/botrestaurantes

# ── Autenticación JWT ─────────────────────────────────────────────────────────
# Clave secreta para firmar tokens de sesión de la app de cocina (app-chef)
JWT_SECRET=urbano_jwt_secret_super_seguro_2026_cambiar_en_produccion

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001
BACKEND_URL=http://localhost:3001    # URL pública del servidor

# Zona horaria del restaurante (offset respecto a UTC, entero).
# Nicaragua / Honduras / Guatemala / El Salvador / Costa Rica = -6
# Colombia / Panamá / Perú = -5
TZ_OFFSET=-6

# ── WhatsApp — Evolution API ─────────────────────────────────────────────────
WHATSAPP_ENABLED=true                # true para activar el listener de notificaciones
RESTAURANTE_ID=urbano                # ID del restaurante

# URL de Evolution API:
#   - Desarrollo local (fuera de Docker): http://localhost:6543 o http://localhost:8080
#   - Dentro de Docker (backend container): http://evolution-api:8080
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=cambia_esta_clave_segura
EVOLUTION_INSTANCE=bot-restaurantes

# ── Logs viewer ───────────────────────────────────────────────────────────────
LOGS_USER=admin
LOGS_PASSWORD=cambia_esta_contrasena
LOGS_SESSION_SECRET=cambia_este_secreto_generalo_con_openssl_rand_hex_32

# ── Docker ────────────────────────────────────────────────────────────────────
BOT_CONTAINER_NAME=bot-restaurantes
BACKEND_VOLUME=backend_data
