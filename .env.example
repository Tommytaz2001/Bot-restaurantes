# ══════════════════════════════════════════════════════════════════════════════
# Bot Restaurantes — Variables de entorno
# ══════════════════════════════════════════════════════════════════════════════
# Copia este archivo como .env y completa los valores reales:
#   cp .env.example .env
#
# NUNCA subas .env al repositorio.
# ══════════════════════════════════════════════════════════════════════════════

# ── OpenAI ────────────────────────────────────────────────────────────────────
# API key para GPT-4o-mini (agente conversacional).
# Obtenerla en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ── Firebase ──────────────────────────────────────────────────────────────────
# Proyecto Firebase con Firestore (pedidos, menu, sesiones) y Storage (comprobantes).
# Obtener estos valores en: Firebase Console → Configuracion del proyecto → General
FIREBASE_API_KEY=AIzaSy...
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001
BACKEND_URL=http://localhost:3001    # URL publica del servidor (para logs y referencia en app-chef)

# ── WhatsApp — Evolution API ─────────────────────────────────────────────────
# Evolution API envuelve Baileys como REST API dentro de Docker.
# No requiere aprobacion de Meta ni URL publica — funciona con cualquier numero.
WHATSAPP_ENABLED=true                # true para activar el listener de notificaciones
RESTAURANTE_ID=urbano                # ID del restaurante en Firestore (coleccion restaurantes/)

# URL de Evolution API:
#   - Desarrollo local (fuera de Docker): http://localhost:8080
#   - Dentro de Docker (backend container): http://evolution-api:8080
EVOLUTION_API_URL=http://evolution-api:8080

# API key para autenticar con Evolution API.
# Tu la defines — debe coincidir con AUTHENTICATION_API_KEY en docker-compose.yml.
# Usa un valor seguro en produccion (ej: openssl rand -hex 32).
EVOLUTION_API_KEY=cambia_esta_clave

# Nombre de la instancia WhatsApp en Evolution API.
# Se crea con: bash scripts/setup-evolution.sh
EVOLUTION_INSTANCE=bot-restaurantes

# ── Docker ────────────────────────────────────────────────────────────────────
BOT_CONTAINER_NAME=bot-restaurantes   # nombre del contenedor del backend
BACKEND_VOLUME=backend_data           # volumen para datos persistentes del backend
